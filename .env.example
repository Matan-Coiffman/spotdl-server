# Settings for docker-compose.server.yml. Copy to .env and edit.

# Required: everyone who uses the server signs in with this password.
SPOTDL_PASSWORD=

# Default format and quality for new downloads (people can change them in the UI).
# Formats: mp3, flac, ogg, opus, m4a, wav. Quality: auto, 128k, 160k, 192k, 256k, 320k.
SPOTDL_FORMAT=mp3
SPOTDL_BITRATE=auto

# Finished downloads are deleted after this many hours (0 keeps them forever).
SPOTDL_RETENTION_HOURS=24

# How much the server does at once, and the largest album/playlist/artist it accepts.
SPOTDL_MAX_CONCURRENT_JOBS=2
SPOTDL_THREADS=4
SPOTDL_MAX_TRACKS=500

# Where the port is published. Use 127.0.0.1 together with the https profile below.
SPOTDL_BIND=0.0.0.0
SPOTDL_PUBLISH_PORT=8800

# HTTPS: your domain, pointed at this machine. Start with `--profile https`.
SPOTDL_DOMAIN=

# If YouTube blocks your server's IP: a cookies.txt from a logged-in browser, or a proxy.
# SPOTDL_COOKIE_FILE=/cookies.txt
# SPOTDL_PROXY=http://user:pass@1.2.3.4:8080

TZ=UTC
