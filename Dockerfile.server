# spotDL web server: the web UI plus its download backend. Published images are at
# ghcr.io/matan-coiffman/spotdl-server; to build your own instead:
#
#   docker build -f Dockerfile.server -t ghcr.io/matan-coiffman/spotdl-server:latest .
#
# Configuration is done with SPOTDL_* environment variables, see docs/server.md.

FROM python:3.13-slim-trixie AS build

COPY --from=ghcr.io/astral-sh/uv:0.11.12 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Dependencies first, so code changes don't reinstall them
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project

COPY spotdl ./spotdl
RUN uv sync --frozen --no-dev --no-editable

# YouTube changes often and old yt-dlp releases start failing with HTTP 403.
# Build with --build-arg YT_DLP_VERSION=<release> to move past the locked one.
ARG YT_DLP_VERSION=""
RUN if [ -n "$YT_DLP_VERSION" ]; then \
        uv pip install --python /app/.venv/bin/python "yt-dlp[default]==$YT_DLP_VERSION"; \
    fi


FROM python:3.13-slim-trixie

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# yt-dlp needs a JavaScript runtime for some YouTube downloads
COPY --from=denoland/deno:bin-2.7.0 /deno /usr/local/bin/deno

RUN useradd --create-home --uid 1000 spotdl \
    && mkdir /data \
    && chown spotdl:spotdl /data

COPY --from=build /app/.venv /app/.venv

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    SPOTDL_HOST=0.0.0.0 \
    SPOTDL_DATA_DIR=/data

USER spotdl
WORKDIR /data
EXPOSE 8800

CMD ["spotdl-server"]
